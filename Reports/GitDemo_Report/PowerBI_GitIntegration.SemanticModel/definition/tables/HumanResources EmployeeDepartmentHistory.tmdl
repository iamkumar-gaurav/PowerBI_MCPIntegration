table 'HumanResources EmployeeDepartmentHistory'
	lineageTag: 2d219534-617b-4893-94af-9feaf17462e8

	/// Count of employees who have left the company (CurrentFlag = False)
	measure 'Terminated Employees' = CALCULATE(DISTINCTCOUNT('HumanResources Employee'[BusinessEntityID]), 'HumanResources Employee'[CurrentFlag] = FALSE())
		lineageTag: 7e196ee0-18f5-4589-842b-95b621c932fc

	/// Turnover rate as a percentage (Terminated / Total) - returns 0% if no terminated employees
	measure 'Turnover Rate %' =
			VAR Terminated = CALCULATE(DISTINCTCOUNT('HumanResources Employee'[BusinessEntityID]), 'HumanResources Employee'[CurrentFlag] = FALSE())
			VAR Total = DISTINCTCOUNT('HumanResources Employee'[BusinessEntityID])
			RETURN DIVIDE(Terminated, Total, 0)
		formatString: 0.00%
		lineageTag: b371058a-324f-45db-8bb6-64053f1d6c8c

	/// Count of active employees in current department/role assignment
	measure 'Current Assignments' = CALCULATE(DISTINCTCOUNT('HumanResources EmployeeDepartmentHistory'[BusinessEntityID]), 'HumanResources EmployeeDepartmentHistory'[EndDate] = BLANK())
		lineageTag: 0593df4d-10d8-4fb6-81c1-32d1503aee6c

	/// Average tenure in current role (days)
	measure 'Avg Role Tenure (Days)' = AVERAGEX(FILTER('HumanResources EmployeeDepartmentHistory', 'HumanResources EmployeeDepartmentHistory'[EndDate] = BLANK()), DATEDIFF('HumanResources EmployeeDepartmentHistory'[StartDate], TODAY(), DAY))
		lineageTag: e2013f42-8f18-4972-86e5-86252e1e977b

	/// Count of historical role changes (EndDate not null)
	measure 'Completed Assignments' = CALCULATE(COUNTA('HumanResources EmployeeDepartmentHistory'[EndDate]), 'HumanResources EmployeeDepartmentHistory'[EndDate] <> BLANK())
		lineageTag: a1dd118e-c80b-4a1e-a5c9-ebb25e3e0458

	column BusinessEntityID
		dataType: int64
		formatString: 0
