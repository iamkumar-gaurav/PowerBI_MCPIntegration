table 'HumanResources Shift'
	lineageTag: 628f8e5d-f5ee-4b77-bf0e-d6deb4d40c1d

	/// Total count of unique shifts defined in the system
	measure 'Total Shifts' = DISTINCTCOUNT('HumanResources Shift'[ShiftID])
		lineageTag: bf92542c-f2c4-49df-8b76-dd11e3c21ec4

	/// Count of employees assigned to day shift in current assignments
	measure 'Day Shift Employees' = CALCULATE(DISTINCTCOUNT('HumanResources EmployeeDepartmentHistory'[BusinessEntityID]), 'HumanResources EmployeeDepartmentHistory'[EndDate] = BLANK(), 'HumanResources Shift'[Name] IN {"Day", "Morning"})
		lineageTag: f772935f-3936-4d53-be2c-d2a1aeac57f7

	/// Count of employees assigned to evening shift in current assignments
	measure 'Evening Shift Employees' = CALCULATE(DISTINCTCOUNT('HumanResources EmployeeDepartmentHistory'[BusinessEntityID]), 'HumanResources EmployeeDepartmentHistory'[EndDate] = BLANK(), 'HumanResources Shift'[Name] = "Evening")
		lineageTag: cdb30b30-4ff6-471a-b44e-a69177bd5e96

	/// Count of employees assigned to night shift in current assignments
	measure 'Night Shift Employees' = CALCULATE(DISTINCTCOUNT('HumanResources EmployeeDepartmentHistory'[BusinessEntityID]), 'HumanResources EmployeeDepartmentHistory'[EndDate] = BLANK(), 'HumanResources Shift'[Name] = "Night")
		lineageTag: b1296f17-5b52-4f58-839a-cc3eb367f695

	/// Percentage distribution of workforce across shifts
	measure 'Shift Coverage %' = DIVIDE(CALCULATE(DISTINCTCOUNT('HumanResources EmployeeDepartmentHistory'[BusinessEntityID]), 'HumanResources EmployeeDepartmentHistory'[EndDate] = BLANK()), [Current Assignments])
		lineageTag: 2d2166f7-1cdf-403d-86aa-272699aa2b3a

	column ShiftID
		dataType: int64
		formatString: 0
		lineageTag: 51e1e512-7fcd-408f-bd34-d0aa00b3839a
		summarizeBy: none
