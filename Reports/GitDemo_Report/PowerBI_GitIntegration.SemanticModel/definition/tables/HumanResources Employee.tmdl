	/// Organizational level label based on OrganizationLevel (1=Executive, 2=Manager, 3+ Specialist)
	column 'Org Level Label' = SWITCH('HumanResources Employee'[OrganizationLevel], 1, "Executive", 2, "Manager", 3, "Senior Specialist", 4, "Specialist", "Other")
		dataType: string
		lineageTag: 1eb0259c-e2ee-44d8-9c22-d03c385c40c8

