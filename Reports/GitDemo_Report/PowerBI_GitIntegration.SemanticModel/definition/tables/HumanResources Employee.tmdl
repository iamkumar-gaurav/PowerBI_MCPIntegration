table 'HumanResources Employee'
	lineageTag: 44a60759-6197-45b6-84a8-d58147c4f10b

	/// Count of active employees (CurrentFlag = True)
	measure 'Current Employees' = CALCULATE(DISTINCTCOUNT('HumanResources Employee'[BusinessEntityID]), 'HumanResources Employee'[CurrentFlag] = TRUE())
		lineageTag: 0d045bee-13a7-497f-b9f3-48c8e762e2c5

	/// Count of all employees including terminated
	measure 'Total Employees' = DISTINCTCOUNT('HumanResources Employee'[BusinessEntityID])
		lineageTag: d26d2d25-f2aa-4a91-a4a7-919e9df9c986

	/// Average years of service from HireDate to today
	measure 'Average Tenure (Years)' = AVERAGEX('HumanResources Employee', DATEDIFF('HumanResources Employee'[HireDate], TODAY(), YEAR))
		lineageTag: 13b8bef1-7d34-4d33-8bd2-c7dec24d97a2

	/// Executive-level employees (OrganizationLevel = 1)
	measure 'Org Level 1 Count' = CALCULATE(DISTINCTCOUNT('HumanResources Employee'[BusinessEntityID]), 'HumanResources Employee'[OrganizationLevel] = 1)
		lineageTag: fe3cc8d0-6cde-4db0-97fb-fb9b8cc03cff

	/// Count of employees on salary (SalariedFlag = True)
	measure 'Salaried Employees' = CALCULATE(DISTINCTCOUNT('HumanResources Employee'[BusinessEntityID]), 'HumanResources Employee'[SalariedFlag] = TRUE())
		lineageTag: 568a9863-4e02-48e7-9d46-f8f4d12c73ef

	/// Count of employees on hourly pay (SalariedFlag = False)
	measure 'Hourly Employees' = CALCULATE(DISTINCTCOUNT('HumanResources Employee'[BusinessEntityID]), 'HumanResources Employee'[SalariedFlag] = FALSE())
		lineageTag: 312ff720-a3bd-449f-83b0-0f1bcc8a5ccd

	/// Debug: Count of terminated employees
	measure 'DEBUG - Terminated Count' = CALCULATE(DISTINCTCOUNT('HumanResources Employee'[BusinessEntityID]), 'HumanResources Employee'[CurrentFlag] = FALSE())
		lineageTag: 84bea413-e58d-407d-81ab-6c8e460e8ee6

	/// Debug: Count of all employees
	measure 'DEBUG - Total Count' = DISTINCTCOUNT('HumanResources Employee'[BusinessEntityID])
		lineageTag: 3c109b5b-5c06-4aa5-8b81-fc2619e86f28

	/// Turnover rate as % - simplified (uses Employee table to avoid context issues)
	measure 'Turnover Rate % (Fixed)' = IF(DISTINCTCOUNT('HumanResources Employee'[BusinessEntityID]) = 0, 0, CALCULATE(DISTINCTCOUNT('HumanResources Employee'[BusinessEntityID]), 'HumanResources Employee'[CurrentFlag] = FALSE()) / DISTINCTCOUNT('HumanResources Employee'[BusinessEntityID]))
		formatString: 0.00%
		lineageTag: 57f01342-de53-415e-a20b-83142c3fd91e

	/// Debug: Count current employees (CurrentFlag = TRUE)
	measure 'DEBUG - Current Count' = CALCULATE(DISTINCTCOUNT('HumanResources Employee'[BusinessEntityID]), 'HumanResources Employee'[CurrentFlag] = TRUE())
		lineageTag: e411464e-f47a-4086-8b34-5c3dd5938b96

	/// Turnover rate (currently all active employees)
	measure 'Turnover Rate % (v3)' = 0
		formatString: 0.00%
		lineageTag: 177db071-9bb5-4094-8759-74872b483871

